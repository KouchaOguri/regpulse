---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WarningLettersExplorer from '../../components/WarningLettersExplorer';
import WatchlistModal from '../../components/WatchlistModal';
import warningLettersData from '../../data/warning_letters.json';
import metadata from '../../data/metadata.json';
import type { WarningLetterRecord } from '../../engine/scanner';

const letters = warningLettersData as WarningLetterRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const syncDate = ((metadata as any).warningLettersLastSyncedUtc || metadata.lastSyncedUtc).slice(0, 10);
---

<BaseLayout
  title="Live FDA Warning Letters Enforcement Radar (2025–2026) | RegPulse"
  description="Search and filter live official FDA Warning Letters across CDER OTC drugs, dietary supplements, cosmetics, medical devices, and animal products, with direct FDA.gov letter links."
  canonicalPath="/warning-letters/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
            Live FDA.gov Enforcement Intelligence
          </p>
          <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
            Live FDA Warning Letters Radar ({letters.length} Latest Letters)
          </h1>
          <p class="mt-3 text-sm sm:text-base text-slate-600">
            Synced directly from the official FDA.gov Warning Letters registry (last synced <strong class="font-mono text-slate-800">{syncDate} UTC</strong>). Track CGMP failures, unapproved drug claims, OTC monograph violations, and overseas OEM enforcement actions before they hit your supply chain.
          </p>
        </div>
        <button
          type="button"
          id="open-wl-alert-btn"
          class="rounded-xl bg-teal-700 px-4 py-2.5 text-xs font-bold text-white hover:bg-teal-800 cursor-pointer"
        >
          Monitor OEMs &amp; Warning Letters ($29/mo)
        </button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <WarningLettersExplorer client:load letters={letters} basePath={base} locale="en" />
  </section>

  <WatchlistModal client:idle locale="en" />

  <script is:inline>
    document.getElementById('open-wl-alert-btn')?.addEventListener('click', function () {
      window.dispatchEvent(new CustomEvent('regpulse:open-watchlist', { detail: { plan: 'Watchlist Radar Pro ($29/mo)' } }));
    });
  </script>
</BaseLayout>
