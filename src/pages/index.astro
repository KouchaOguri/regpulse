---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingScanner from '../components/ListingScanner';
import WatchlistModal from '../components/WatchlistModal';
import recallsData from '../data/recalls.json';
import warningLettersData from '../data/warning_letters.json';
import metadata from '../data/metadata.json';
import { COMPLIANCE_RULES } from '../data/complianceRules';
import type { RecallRecord, WarningLetterRecord } from '../engine/scanner';

const recalls = recallsData as RecallRecord[];
const warningLetters = warningLettersData as WarningLetterRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const recentCritical = recalls.filter((r) => r.classification === 'Class I').slice(0, 4);
const recentWarningLetters = warningLetters.slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'RegPulse — FDA Drug-Claim, Warning Letters & MoCRA Compliance Radar',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description:
    'Citation-backed 40-rule FDA drug-claim, MoCRA cosmetics, 200-SKU Bulk CSV pre-flight scanner, and live FDA Warning Letters & openFDA recall monitoring.',
};
---

<BaseLayout
  title="RegPulse — FDA Drug-Claim Scanner, 200-SKU Bulk Audit & Live Warning Letters Radar"
  description="Catch FDA drug claims, OTC SPF/lidocaine/eye-drop triggers, EPA FIFRA pesticide traps, and MoCRA label gaps in seconds across 40 verified statutes before Amazon suppresses your ASIN."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <div class="max-w-4xl">
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-teal-200 bg-teal-50/80 px-3 py-1 text-xs font-semibold text-teal-900 mb-4">
          <span class="inline-block h-2 w-2 rounded-full bg-teal-600" aria-hidden="true"></span>
          <span>Live FDA.gov &amp; openFDA Sync • {warningLetters.length} Warning Letters • {metadata.totalRecallsIndexed} Recalls • {COMPLIANCE_RULES.length} Verified Statutory Rules</span>
        </div>

        <h1 id="main-content" tabindex="-1" class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 leading-[1.12]">
          Catch FDA Drug Claims &amp; Amazon Suppression Triggers in 10 Seconds.
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl">
          Built for <strong>Cosmetics (MoCRA)</strong>, <strong>Dietary Supplements (DSHEA)</strong>, <strong>Beauty/Medical Devices</strong>, and <strong>Pet Products (CVM)</strong>. Paste a single listing free—or upload a <strong>200-SKU Amazon/Shopify CSV</strong>—for instant 21 CFR citation-backed audits, safe rewrite copy, and live FDA Warning Letters &amp; openFDA recall cross-checks.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href={withBase('/bulk/')}
            class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-800"
          >
            Audit a 200-SKU Store CSV (Free 3-SKU Preview) →
          </a>
          <a
            href={withBase('/warning-letters/')}
            class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-800 hover:bg-slate-50"
          >
            Browse {warningLetters.length} Live FDA Warning Letters
          </a>
        </div>
      </div>

      <!-- Live Trust Metrics Strip -->
      <div class="mt-7 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        <a href={withBase('/warning-letters/')} class="rounded-xl border border-slate-200 bg-slate-50/80 p-3.5 hover:border-teal-400 transition-colors">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Live FDA Warning Letters</div>
          <div class="mt-1 text-2xl font-extrabold text-slate-900 tabular-nums">{warningLetters.length}</div>
          <div class="text-[11px] text-slate-500 mt-0.5 whitespace-nowrap">Direct from FDA.gov DataTable</div>
        </a>
        <a href={withBase('/recalls/')} class="rounded-xl border border-slate-200 bg-slate-50/80 p-3.5 hover:border-teal-400 transition-colors">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Live openFDA Recalls</div>
          <div class="mt-1 text-2xl font-extrabold text-slate-900 tabular-nums">{metadata.totalRecallsIndexed}</div>
          <div class="text-[11px] text-slate-500 mt-0.5 whitespace-nowrap">Synced {metadata.lastSyncedUtc.slice(0, 10)} UTC</div>
        </a>
        <a href={withBase('/rules/')} class="rounded-xl border border-slate-200 bg-slate-50/80 p-3.5 hover:border-teal-400 transition-colors">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Statutory Rule Modules</div>
          <div class="mt-1 text-2xl font-extrabold text-slate-900 tabular-nums">{COMPLIANCE_RULES.length}</div>
          <div class="text-[11px] text-slate-500 mt-0.5">21 CFR • MoCRA • CVM • FIFRA • FTC</div>
        </a>
        <a href={withBase('/bulk/')} class="rounded-xl border border-slate-200 bg-slate-50/80 p-3.5 hover:border-teal-400 transition-colors">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Bulk Catalog Pre-Flight</div>
          <div class="mt-1 text-2xl font-extrabold text-slate-900 tabular-nums">200 SKUs</div>
          <div class="text-[11px] text-slate-500 mt-0.5">Local CSV scan + Remediation Export</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Main Interactive Scanner -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-5">
    <!-- Lightweight, Zero-Popup 1-2-3 Quick-Start Guide -->
    <ol aria-label="How to use RegPulse in 3 steps" class="grid gap-3 md:grid-cols-3 no-print">
      <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 flex items-start gap-3 shadow-2xs">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-xs font-extrabold text-white shrink-0 mt-0.5">1</span>
        <div class="text-xs leading-relaxed">
          <div class="font-bold text-slate-900">Select Your Product Category</div>
          <p class="text-slate-600 mt-0.5">Choose Cosmetics, Supplements, Devices, or Pets so the scanner loads the exact FDA &amp; CVM rulebook for your SKU.</p>
        </div>
      </li>
      <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 flex items-start gap-3 shadow-2xs">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-xs font-extrabold text-white shrink-0 mt-0.5">2</span>
        <div class="text-xs leading-relaxed">
          <div class="font-bold text-slate-900">Paste Draft Copy (or Click a Sample)</div>
          <p class="text-slate-600 mt-0.5">Drop in your Title, Bullet Points, and Ingredients—runs 100% locally in your browser with zero server upload.</p>
        </div>
      </li>
      <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 flex items-start gap-3 shadow-2xs">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-xs font-extrabold text-white shrink-0 mt-0.5">3</span>
        <div class="text-xs leading-relaxed">
          <div class="font-bold text-slate-900">Copy Safe Rewrites or Audit 200 SKUs</div>
          <p class="text-slate-600 mt-0.5">Fix flagged triggers using the 21 CFR rewrite templates, export a PDF trail, or upload a catalog CSV on <a href={withBase('/bulk/')} class="font-semibold text-teal-700 underline">Bulk CSV</a>.</p>
        </div>
      </li>
    </ol>

    <ListingScanner client:load recalls={recalls} warningLetters={warningLetters} basePath={base} locale="en" />
  </section>

  <!-- Live Warning Letters & Class I Recalls Dual Feed -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 no-print">
    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Latest Live FDA Warning Letters -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-2 mb-4">
          <h2 class="text-lg font-extrabold text-slate-950">Latest Official FDA Warning Letters</h2>
          <a href={withBase('/warning-letters/')} class="text-xs font-semibold text-teal-700 hover:underline shrink-0">
            View all {warningLetters.length} →
          </a>
        </div>
        <ul class="space-y-3">
          {recentWarningLetters.map((wl) => (
            <li class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 hover:border-teal-300 transition-colors">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="rounded bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase text-amber-900">
                  {wl.vertical}
                </span>
                <span class="font-mono text-[11px] text-slate-500">
                  {wl.postedDate}{wl.cmsId ? ` • CMS #${wl.cmsId}` : ''}
                </span>
              </div>
              <a href={withBase(`/warning-letters/${wl.id}/`)} class="mt-1.5 block text-sm font-bold text-slate-900 hover:text-teal-800">
                {wl.companyName}
              </a>
              <p class="mt-1 text-xs text-slate-600 line-clamp-2">{wl.subject}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Latest Class I Recalls -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-2 mb-4">
          <h2 class="text-lg font-extrabold text-slate-950">Latest Class I (Highest Risk) FDA Recalls</h2>
          <a href={withBase('/recalls/')} class="text-xs font-semibold text-teal-700 hover:underline shrink-0">
            View all {metadata.totalRecallsIndexed} →
          </a>
        </div>
        <ul class="space-y-3">
          {recentCritical.map((rec) => (
            <li class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 hover:border-teal-300 transition-colors">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="rounded bg-red-100 px-2 py-0.5 text-[10px] font-bold uppercase text-red-900">
                  {rec.classification} • {rec.vertical}
                </span>
                <span class="font-mono text-[11px] text-slate-500">{rec.reportDate}</span>
              </div>
              <a href={withBase(`/recalls/${rec.id}/`)} class="mt-1.5 block text-sm font-bold text-slate-900 hover:text-teal-800">
                {rec.recallingFirm} ({rec.recallNumber})
              </a>
              <p class="mt-1 text-xs text-slate-600 line-clamp-2">{rec.reasonForRecall}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Why RegPulse vs Enterprise RegTech -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 no-print">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-950">
          Why SMB Brands Switch from Manual FDA Checks &amp; $10,000+ Enterprise Suites
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Enterprise regulatory suites lock pricing behind annual sales contracts, and compliance agencies bill $150–$250 per single SKU review. RegPulse delivers instant self-serve 200-SKU screening and automated Warning Letter &amp; Recall monitoring at e-commerce economics.
        </p>
      </div>

      <div tabindex="0" role="region" aria-labelledby="compare-caption" class="rp-table-wrapper">
        <table class="rp-table">
          <caption id="compare-caption" class="visually-hidden">RegPulse comparison against enterprise regulatory suites and compliance agencies</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col" class="bg-teal-50! text-teal-950!">RegPulse (Self-Serve)</th>
              <th scope="col">Enterprise QRI (Redica / Basil)</th>
              <th scope="col">Compliance Agencies</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="font-semibold text-slate-900">Transparent Pricing</th>
              <td data-label="RegPulse" class="font-bold text-teal-800">Free • $19 Bulk Pass • $29–$79/mo</td>
              <td data-label="Enterprise QRI">$5,000 – $50,000+ / year (Quote Only)</td>
              <td data-label="Agencies">$150–$250 / SKU + $800+/yr agent</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold text-slate-900">200-SKU Amazon / Shopify Audit</th>
              <td data-label="RegPulse">&lt;1s local CSV audit + Remediation Export</td>
              <td data-label="Enterprise QRI">Not built for e-commerce listing copy</td>
              <td data-label="Agencies">Manual 3–7 business day turnaround</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold text-slate-900">Live Warning Letters + Recalls</th>
              <td data-label="RegPulse">Automated 12h sync + Slack / Email / Webhook</td>
              <td data-label="Enterprise QRI">Yes (Pharma QA enterprise tier)</td>
              <td data-label="Agencies">Manual consultant newsletter</td>
            </tr>
            <tr>
              <th scope="row" class="font-semibold text-slate-900">Zero-Hallucination Citations</th>
              <td data-label="RegPulse">100% CI-Locked HTTP 200 eCFR &amp; FDA.gov</td>
              <td data-label="Enterprise QRI">Yes</td>
              <td data-label="Agencies">Manual memo</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Data Methodology -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 no-print">
    <div class="rounded-2xl border border-slate-200 bg-slate-900 text-slate-200 p-6 sm:p-7">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="text-sm font-bold uppercase tracking-wider text-teal-400">
            Deterministic Verification &amp; Data Integrity Methodology
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-slate-300">
            Every statutory citation across all {COMPLIANCE_RULES.length} RegPulse rules is verified in CI via headless Chromium against official eCFR, FDA.gov, EPA.gov, and U.S. Code endpoints. Warning Letters and openFDA enforcement recalls sync automatically every 12 hours and pass SHA-256 provenance checks plus live openFDA round-trip spot verification.
          </p>
        </div>
        <a
          href="https://github.com/KouchaOguri/regpulse"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 text-xs font-semibold text-white hover:bg-slate-700 shrink-0"
        >
          Inspect Sync Pipeline on GitHub ↗
        </a>
      </div>
    </div>
  </section>

  <WatchlistModal client:idle locale="en" />
</BaseLayout>
