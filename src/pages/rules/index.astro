---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPLIANCE_RULES } from '../../data/complianceRules';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<BaseLayout
  title="21 CFR, MoCRA & Amazon Prohibited Claims Rule Library | RegPulse"
  description="Browse all 18 statutory FDA drug-claim rules, OTC sunscreen & dandruff monographs, prohibited cosmetic ingredients, DSHEA triggers, and EPA FIFRA pesticide bot traps."
  canonicalPath="/rules/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
        <span data-i18n-en>Statutory Compliance Playbook</span>
        <span data-i18n-zh class="hidden">联邦法典合规排查指南</span>
      </p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        <span data-i18n-en>FDA 21 CFR, MoCRA &amp; Amazon Bot Trigger Library ({COMPLIANCE_RULES.length} Rules)</span>
        <span data-i18n-zh class="hidden">FDA 21 CFR、MoCRA 与 Amazon 违禁词法规百科（{COMPLIANCE_RULES.length} 项）</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-3xl">
        <span data-i18n-en>Every rule inside the RegPulse scanner is tied directly to federal statutes (eCFR 21 CFR, FD&amp;C Act, EPA FIFRA, 15 U.S.C. §52) verified via automated HTTP 200 browser checks, with ready-to-paste safe rewrites.</span>
        <span data-i18n-zh class="hidden">RegPulse 内置的每一条规则均直接溯源美国联邦法典（eCFR 21 CFR / FD&amp;C Act / EPA FIFRA / 15 U.S.C. §52），外链均经真浏览器锁定 HTTP 200，并附安全合规改写模板。</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid gap-5 md:grid-cols-2">
      {COMPLIANCE_RULES.map((rule) => (
        <article class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm hover:border-teal-400 transition-colors flex flex-col justify-between">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-md bg-red-50 border border-red-200 px-2 py-0.5 text-[11px] font-bold uppercase text-red-900">
                {rule.severity} • {rule.category}
              </span>
              <span class="font-mono text-[11px] text-slate-400">{rule.id}</span>
            </div>
            <h2 class="mt-3 text-base sm:text-lg font-bold text-slate-950 break-words">
              <a href={withBase(`/rules/${rule.slug}/`)} class="hover:text-teal-800">
                <span data-i18n-en>{rule.titleEn}</span>
                <span data-i18n-zh class="hidden">{rule.titleZh}</span>
              </a>
            </h2>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed break-words">
              <span data-i18n-en>{rule.whyFlaggedEn}</span>
              <span data-i18n-zh class="hidden">{rule.whyFlaggedZh}</span>
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs">
            <span class="font-mono text-slate-500 break-words min-w-0 max-w-full">{rule.statute}</span>
            <a href={withBase(`/rules/${rule.slug}/`)} class="font-semibold text-teal-700 hover:underline shrink-0">
              <span data-i18n-en>Read Guide &amp; Rewrites →</span>
              <span data-i18n-zh class="hidden">查看法条与改写 →</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
