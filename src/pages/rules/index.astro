---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPLIANCE_RULES } from '../../data/complianceRules';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<BaseLayout
  title="21 CFR, MoCRA & Amazon Prohibited Claims Rule Library | RegPulse"
  description="Browse every statutory FDA drug-claim rule, prohibited cosmetic ingredient list, DSHEA disease trigger, and EPA FIFRA pesticide bot trap with safe compliant rewrites."
  canonicalPath="/rules/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">Statutory Compliance Playbook</p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        <span data-i18n-en>FDA 21 CFR, MoCRA &amp; Amazon Bot Trigger Library</span>
        <span data-i18n-zh class="hidden">FDA 21 CFR、MoCRA 与 Amazon 违禁词法规百科</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-3xl">
        <span data-i18n-en>Every rule inside the RegPulse scanner is tied directly to federal statutes (21 CFR, FD&amp;C Act, EPA FIFRA, FTC) and includes compliant alternative copy you can paste straight into Amazon or Shopify.</span>
        <span data-i18n-zh class="hidden">RegPulse 引擎内置的每一条扫描规则均直接溯源美国联邦法典（21 CFR / FD&amp;C Act / EPA FIFRA / FTC），并附可直接套用的安全合规改写模板。</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid gap-5 md:grid-cols-2">
      {COMPLIANCE_RULES.map((rule) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-teal-400 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-md bg-red-50 border border-red-200 px-2 py-0.5 text-[11px] font-bold uppercase text-red-900">
                {rule.severity} • {rule.category}
              </span>
              <span class="font-mono text-[11px] text-slate-400">{rule.id}</span>
            </div>
            <h2 class="mt-3 text-lg font-bold text-slate-950">
              <a href={withBase(`/rules/${rule.slug}/`)} class="hover:text-teal-800">
                <span data-i18n-en>{rule.titleEn}</span>
                <span data-i18n-zh class="hidden">{rule.titleZh}</span>
              </a>
            </h2>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              <span data-i18n-en>{rule.whyFlaggedEn}</span>
              <span data-i18n-zh class="hidden">{rule.whyFlaggedZh}</span>
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between gap-2 text-xs">
            <span class="font-mono text-slate-500 truncate">{rule.statute}</span>
            <a href={withBase(`/rules/${rule.slug}/`)} class="font-semibold text-teal-700 hover:underline shrink-0">
              Read Guide &amp; Rewrites →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
