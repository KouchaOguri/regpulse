---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPLIANCE_RULES, type ComplianceRule } from '../../data/complianceRules';

export function getStaticPaths() {
  return COMPLIANCE_RULES.map((rule) => ({
    params: { slug: rule.slug },
    props: { rule },
  }));
}

interface Props {
  rule: ComplianceRule;
}

const { rule } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: rule.seoQuestionEn,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${rule.whyFlaggedEn} Safe compliant alternative: ${rule.safeRewriteEn} Statutory basis: ${rule.statute}.`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${rule.seoQuestionEn} | RegPulse FDA Compliance Guide`}
  description={`${rule.whyFlaggedEn.slice(0, 155)}`}
  canonicalPath={`/rules/${rule.slug}/`}
  jsonLd={faqJsonLd}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-slate-500">
      <a href={withBase('/')} class="hover:text-slate-900">
        <span data-i18n-en>Home</span>
        <span data-i18n-zh class="hidden">首页</span>
      </a>
      <span class="mx-1.5">/</span>
      <a href={withBase('/rules/')} class="hover:text-slate-900">
        <span data-i18n-en>21 CFR Rule Library</span>
        <span data-i18n-zh class="hidden">法规词库</span>
      </a>
      <span class="mx-1.5">/</span>
      <span class="font-mono text-slate-800">{rule.id}</span>
    </nav>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm space-y-6">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="rounded-md bg-red-100 px-2.5 py-0.5 text-xs font-bold uppercase text-red-900">
            {rule.severity} Risk
          </span>
          <span class="rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">
            {rule.category}
          </span>
          <span class="font-mono text-xs text-slate-500">{rule.id}</span>
        </div>

        <h1 id="main-content" tabindex="-1" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-950">
          <span data-i18n-en>{rule.seoQuestionEn}</span>
          <span data-i18n-zh class="hidden">{rule.seoQuestionZh}</span>
        </h1>
      </div>

      <section class="rounded-xl bg-red-50/60 border border-red-200 p-5">
        <h2 class="text-sm font-bold text-red-950">
          <span data-i18n-en>Why FDA &amp; Amazon Bots Flag This Claim</span>
          <span data-i18n-zh class="hidden">为什么 FDA 执法与 Amazon 扫号机器人会处罚此类表述</span>
        </h2>
        <p class="mt-2 text-sm text-red-950/90 leading-relaxed">
          <span data-i18n-en>{rule.whyFlaggedEn}</span>
          <span data-i18n-zh class="hidden">{rule.whyFlaggedZh}</span>
        </p>
      </section>

      <section class="rounded-xl bg-emerald-50/70 border border-emerald-200 p-5">
        <h2 class="text-sm font-bold text-emerald-950">
          <span data-i18n-en>Compliant Alternative Copy (Safe Rewrite)</span>
          <span data-i18n-zh class="hidden">安全合规改写模板</span>
        </h2>
        <p class="mt-2 text-sm text-emerald-950 leading-relaxed">
          <span data-i18n-en>{rule.safeRewriteEn}</span>
          <span data-i18n-zh class="hidden">{rule.safeRewriteZh}</span>
        </p>
      </section>

      <section class="rounded-xl bg-slate-50 border border-slate-200 p-5 space-y-2">
        <h2 class="text-sm font-bold text-slate-900">
          <span data-i18n-en>Official Statutory Citation &amp; Enforcement Precedent</span>
          <span data-i18n-zh class="hidden">官方法条出处与真实执法惯例</span>
        </h2>
        <p class="text-xs font-mono text-slate-700 break-words">
          <strong>
            <span data-i18n-en>Statute:</span>
            <span data-i18n-zh class="hidden">法条依据：</span>
          </strong>{' '}
          {rule.statute}
        </p>
        <p class="text-xs text-slate-700 leading-relaxed">
          <span data-i18n-en>{rule.precedentEn}</span>
          <span data-i18n-zh class="hidden">{rule.precedentZh}</span>
        </p>
        <a
          href={rule.officialRefUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block pt-1 text-xs font-semibold text-blue-700 hover:underline"
        >
          <span data-i18n-en>Read Official Source: {rule.officialRefLabel} ↗</span>
          <span data-i18n-zh class="hidden">直连查阅官方原始法条：{rule.officialRefLabel} ↗</span>
        </a>
      </section>

      <div class="rounded-2xl bg-slate-900 text-white p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-base font-bold">
            <span data-i18n-en>Check Your Full Listing Against All {COMPLIANCE_RULES.length} Rules Free</span>
            <span data-i18n-zh class="hidden">免费把整条 Listing 放进 RegPulse 扫描全部 {COMPLIANCE_RULES.length} 项红线规则</span>
          </h2>
          <p class="mt-1 text-xs text-slate-300">
            <span data-i18n-en>Instant browser-local scan + vertical-matched openFDA recall check + audit PDF report.</span>
            <span data-i18n-zh class="hidden">免登录 100% 本地瞬时扫描 + 同行业 openFDA 召回比对 + 可打印审计 PDF 报告。</span>
          </p>
        </div>
        <a
          href={withBase('/')}
          class="rounded-xl bg-teal-500 px-5 py-2.5 text-xs font-bold text-slate-950 hover:bg-teal-400 shrink-0"
        >
          <span data-i18n-en>Open Free Scanner →</span>
          <span data-i18n-zh class="hidden">打开免费体检扫描器 →</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
