---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WatchlistModal from '../../components/WatchlistModal';
---

<BaseLayout
  title="Pricing — Automated FDA Watchlist Alerts & Catalog Compliance | RegPulse"
  description="Self-serve FDA compliance monitoring starting at $29/month (or ¥199/quarter for Chinese cross-border sellers). Zero sales calls, cancel anytime."
  canonicalPath="/pricing/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
        <span data-i18n-en>Transparent Self-Serve Pricing</span>
        <span data-i18n-zh class="hidden">透明自助订阅方案（无隐藏年费 / 随时取消）</span>
      </p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        <span data-i18n-en>Stop Finding Out About FDA Enforcement After Your ASIN Is Suspended.</span>
        <span data-i18n-zh class="hidden">别等主力 ASIN 变狗或货柜被海关扣留，才想起查 FDA 预警。</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">
        <span data-i18n-en>No $15,000 annual enterprise contracts. Keep the single-listing scanner free forever, or automate 24/7 supplier, ingredient, and competitor enforcement alerts.</span>
        <span data-i18n-zh class="hidden">无天价企业年费、无需预约销售 Demo。单条违禁词体检永久免费；升级自动监控即可 7×24 盯防代工厂、高危成分与竞品 FDA 召回及 510(k) 动态。</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-6 lg:grid-cols-3 items-stretch">
      <!-- Free Tier -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-lg font-bold text-slate-900">
            <span data-i18n-en>Free Scanner</span>
            <span data-i18n-zh class="hidden">免费版体检引擎</span>
          </h2>
          <p class="mt-1 text-xs text-slate-500">
            <span data-i18n-en>For solo sellers checking drafts before launch</span>
            <span data-i18n-zh class="hidden">适合个人卖家上新前快速自查 Listing 草稿</span>
          </p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-slate-950">$0</span>
            <span class="text-xs text-slate-500">
              <span data-i18n-en>/ forever</span>
              <span data-i18n-zh class="hidden">/ 永久免费</span>
            </span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-700">
            <li>
              <span data-i18n-en>✓ Unlimited browser-local listing claim scans</span>
              <span data-i18n-zh class="hidden">✓ 无限次浏览器本地极速违禁词扫描（不上传草稿）</span>
            </li>
            <li>
              <span data-i18n-en>✓ All 18 21 CFR, MoCRA, DSHEA &amp; EPA FIFRA rules</span>
              <span data-i18n-zh class="hidden">✓ 覆盖全部 18 项 21 CFR、MoCRA、OTC 与 EPA 规则</span>
            </li>
            <li>
              <span data-i18n-en>✓ Safe compliant rewrite suggestions</span>
              <span data-i18n-zh class="hidden">✓ 附带可直接复制的安全合规改写模板</span>
            </li>
            <li>
              <span data-i18n-en>✓ Printable PDF audit report</span>
              <span data-i18n-zh class="hidden">✓ 支持一键打印/导出审计级 PDF 体检报告</span>
            </li>
            <li>
              <span data-i18n-en>✓ Public live openFDA recall radar lookup</span>
              <span data-i18n-zh class="hidden">✓ 免费检索实时 openFDA 召回与 510(k) 公开库</span>
            </li>
          </ul>
        </div>
        <a
          href={import.meta.env.BASE_URL}
          class="mt-8 block w-full text-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-900 hover:bg-slate-50"
        >
          <span data-i18n-en>Use Free Scanner Now</span>
          <span data-i18n-zh class="hidden">立即免费使用扫描器</span>
        </a>
      </div>

      <!-- Starter Tier -->
      <div class="rounded-2xl border-2 border-teal-600 bg-white p-6 shadow-md relative flex flex-col justify-between">
        <span class="absolute -top-3 left-6 rounded-full bg-teal-700 px-3 py-0.5 text-[11px] font-bold text-white">
          <span data-i18n-en>Most Popular for Sellers</span>
          <span data-i18n-zh class="hidden">跨境卖家首选</span>
        </span>
        <div>
          <h2 class="text-lg font-bold text-slate-900">
            <span data-i18n-en>Starter Watchlist</span>
            <span data-i18n-zh class="hidden">基础预警监控版</span>
          </h2>
          <p class="mt-1 text-xs text-slate-500">
            <span data-i18n-en>Automated FDA recall &amp; enforcement radar</span>
            <span data-i18n-zh class="hidden">自动化 FDA 召回、成分与代工厂风险预警雷达</span>
          </p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-slate-950">
              <span data-i18n-en>$29</span>
              <span data-i18n-zh class="hidden">¥199</span>
            </span>
            <span class="text-xs text-slate-500">
              <span data-i18n-en>/ month (or ¥199 / quarter CN)</span>
              <span data-i18n-zh class="hidden">/ 季度（海外美元版 $29/月）</span>
            </span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-700">
            <li>
              <span data-i18n-en>✓ Everything in Free Scanner</span>
              <span data-i18n-zh class="hidden">✓ 包含免费版全部扫描与 PDF 导出功能</span>
            </li>
            <li>
              <span data-i18n-en>✓ <strong>10 Watchlist Trackers</strong> (OEMs, ingredients, brands, product codes)</span>
              <span data-i18n-zh class="hidden">✓ <strong>10 个核心监控槽位</strong>（代工厂/高危成分/竞品品牌/产品代码）</span>
            </li>
            <li>
              <span data-i18n-en>✓ Instant Email / Slack / WeCom Webhook alerts</span>
              <span data-i18n-zh class="hidden">✓ 命中 FDA 召回实时推送邮件 / 企业微信 / 飞书 / Slack</span>
            </li>
            <li>
              <span data-i18n-en>✓ Weekly FDA Cosmetics &amp; Supplements enforcement digest</span>
              <span data-i18n-zh class="hidden">✓ 每周美妆（MoCRA）与保健品执法高危动态简报</span>
            </li>
            <li>
              <span data-i18n-en>✓ 7-day free pilot run before billing starts</span>
              <span data-i18n-zh class="hidden">✓ 先享 7 天免费试跑预警，满意后再付费</span>
            </li>
          </ul>
        </div>
        <button
          type="button"
          data-plan-en="Starter Watchlist ($29/mo)"
          data-plan-zh="中文跨境监控季卡 (¥199/季)"
          class="plan-cta-btn mt-8 w-full rounded-xl bg-teal-700 px-4 py-3 text-xs font-bold text-white hover:bg-teal-800 cursor-pointer"
        >
          <span data-i18n-en>Start 7-Day Free Pilot ($29/mo)</span>
          <span data-i18n-zh class="hidden">申请 7 天免费试跑（¥199/季）</span>
        </button>
      </div>

      <!-- Pro / Agency Tier -->
      <div class="rounded-2xl border border-slate-200 bg-slate-950 text-white p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-lg font-bold">
            <span data-i18n-en>Pro &amp; Agency</span>
            <span data-i18n-zh class="hidden">专业版 / 多店铺代运营版</span>
          </h2>
          <p class="mt-1 text-xs text-slate-400">
            <span data-i18n-en>For multi-SKU brands, aggregators &amp; RA consultants</span>
            <span data-i18n-zh class="hidden">面向多 SKU 大卖、品牌聚合商与独立法规顾问</span>
          </p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold">
              <span data-i18n-en>$79</span>
              <span data-i18n-zh class="hidden">¥599</span>
            </span>
            <span class="text-xs text-slate-400">
              <span data-i18n-en>/ month</span>
              <span data-i18n-zh class="hidden">/ 季度（海外美元版 $79/月）</span>
            </span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-200">
            <li>
              <span data-i18n-en>✓ <strong>Unlimited Watchlist Trackers</strong> across Drugs, Cosmetics, Foods &amp; Devices</span>
              <span data-i18n-zh class="hidden">✓ <strong>不限数量监控词条</strong>，覆盖美妆/保健品/OTC/器械全库</span>
            </li>
            <li>
              <span data-i18n-en>✓ 510(k) predicate clearance &amp; competitor pipeline alerts</span>
              <span data-i18n-zh class="hidden">✓ 竞品 510(k) 获批与产品代码异动追踪推送</span>
            </li>
            <li>
              <span data-i18n-en>✓ Bulk CSV / catalog compliance pre-audit (up to 250 SKUs/mo)</span>
              <span data-i18n-zh class="hidden">✓ 每月 250 SKU 批量 CSV 合规预审与整改清单</span>
            </li>
            <li>
              <span data-i18n-en>✓ Monthly executive compliance PDF for internal QA trails</span>
              <span data-i18n-zh class="hidden">✓ 月度可留档审计级合规风险汇总 PDF 报告</span>
            </li>
            <li>
              <span data-i18n-en>✓ Priority JSON / Webhook API feed</span>
              <span data-i18n-zh class="hidden">✓ 优先接入结构化 JSON / Webhook 自动化告警流</span>
            </li>
          </ul>
        </div>
        <button
          type="button"
          data-plan-en="Pro & Agency Watchlist ($79/mo)"
          data-plan-zh="专业大卖/代运营季卡 (¥599/季)"
          class="plan-cta-btn mt-8 w-full rounded-xl bg-teal-500 px-4 py-3 text-xs font-bold text-slate-950 hover:bg-teal-400 cursor-pointer"
        >
          <span data-i18n-en>Start 7-Day Free Pilot ($79/mo)</span>
          <span data-i18n-zh class="hidden">申请 7 天免费试跑（¥599/季）</span>
        </button>
      </div>
    </div>

    <!-- Chinese Cross-Border Quick Banner -->
    <div class="mt-10 rounded-2xl border border-teal-200 bg-teal-50/70 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-teal-950">
          <span data-i18n-en>China Cross-Border Seller Edition (RMB / WeCom Alerts)</span>
          <span data-i18n-zh class="hidden">中国美国站跨境卖家专属通道（人民币结算 / 企业微信实时推送）</span>
        </h2>
        <p class="mt-1 text-xs text-teal-900">
          <span data-i18n-en>Built for Shenzhen, Hangzhou &amp; Guangzhou US Amazon/TikTok sellers: ¥199/quarter with Chinese risk summaries and instant WeCom/Feishu Webhook delivery.</span>
          <span data-i18n-zh class="hidden">面向深圳/杭州/广州 Amazon &amp; TikTok Shop 美妆、保健品、美容仪卖家：<strong>¥199 / 季度</strong>（含 10 个核心成分/代工厂/竞品监控 + 中文违规要点拆解 + 企微/飞书群推送）。</span>
        </p>
      </div>
      <button
        type="button"
        data-plan-en="China Cross-Border Edition (¥199/quarter)"
        data-plan-zh="中文跨境监控季卡 (¥199/季)"
        class="plan-cta-btn rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-bold text-white hover:bg-slate-800 shrink-0 cursor-pointer"
      >
        <span data-i18n-en>Start China Edition Pilot</span>
        <span data-i18n-zh class="hidden">申请中文版 7 天免费试跑</span>
      </button>
    </div>
  </section>

  <WatchlistModal client:idle />

  <script is:inline>
    document.querySelectorAll('.plan-cta-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var isZh = document.documentElement.lang === 'zh-CN';
        var plan = isZh
          ? (btn.getAttribute('data-plan-zh') || '中文跨境监控季卡 (¥199/季)')
          : (btn.getAttribute('data-plan-en') || 'Starter Watchlist ($29/mo)');
        window.dispatchEvent(new CustomEvent('regpulse:open-watchlist', { detail: { plan: plan } }));
      });
    });
  </script>
</BaseLayout>
