---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WatchlistModal from '../../components/WatchlistModal';
import { COMPLIANCE_RULES } from '../../data/complianceRules';
import warningLettersData from '../../data/warning_letters.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<BaseLayout
  title="Pricing — 200-SKU Bulk Audit Pass ($19) & Automated FDA Watchlist Radar | RegPulse"
  description="Transparent self-serve FDA compliance pricing: Free single-SKU scanner, $19 one-time 200-SKU Bulk CSV Pre-Flight Pass, or $29/mo automated FDA Warning Letter & openFDA Recall monitoring."
  canonicalPath="/pricing/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
        Transparent Self-Serve Pricing • Instant Automated License Delivery
      </p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        Stop Discovering FDA Violations After Your ASIN Is Suspended.
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">
        No $15,000 enterprise retainers and no manual agency turnaround. Start with a $19 one-time 200-SKU catalog pre-flight pass, or automate 24/7 Warning Letter &amp; Recall monitoring for your OEMs and ingredients.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch">
      <!-- Free Tier -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900">Free Scanner</h2>
          <p class="mt-1 text-xs text-slate-500">Quick draft screening before publishing</p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-slate-950">$0</span>
            <span class="text-xs text-slate-500">/ forever</span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-700">
            <li>✓ Unlimited single-SKU local scans</li>
            <li>✓ All {COMPLIANCE_RULES.length} verified 21 CFR, MoCRA, CVM &amp; FIFRA rules</li>
            <li>✓ 3-SKU preview in Bulk CSV Scanner</li>
            <li>✓ Public lookup across {warningLettersData.length} FDA Warning Letters &amp; 210 Recalls</li>
            <li>✓ Printable single-SKU audit PDF</li>
          </ul>
        </div>
        <a
          href={withBase('/')}
          class="mt-8 block w-full text-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-900 hover:bg-slate-50"
        >
          Use Free Scanner
        </a>
      </div>

      <!-- Impulse One-Time Paid Wedge -->
      <div class="rounded-2xl border-2 border-slate-900 bg-white p-6 shadow-sm relative flex flex-col justify-between">
        <span class="absolute -top-3 left-5 rounded-full bg-slate-900 px-3 py-0.5 text-[11px] font-bold text-white">
          No Subscription Needed
        </span>
        <div>
          <h2 class="text-base font-bold text-slate-900">Bulk Catalog Pass</h2>
          <p class="mt-1 text-xs text-slate-500">Audit your entire catalog before Q4 or product launch</p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-slate-950">$19</span>
            <span class="text-xs text-slate-500">/ one-time</span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-700">
            <li>✓ <strong>200-SKU Bulk CSV Audit</strong> (Amazon Flat File / Shopify)</li>
            <li>✓ Instant automated License Key delivery (0 wait)</li>
            <li>✓ 1-Click <strong>Remediation CSV Export</strong> (Risk Scores, Rules, Safe Rewrites &amp; Statutes)</li>
            <li>✓ 100% browser-local execution (zero catalog upload)</li>
            <li>✓ 7-day satisfaction refund guarantee</li>
          </ul>
        </div>
        <button
          type="button"
          data-plan="Bulk Catalog Pre-Flight Pass ($19 one-time)"
          class="plan-cta-btn mt-8 w-full rounded-xl bg-slate-900 px-4 py-3 text-xs font-bold text-white hover:bg-slate-800 cursor-pointer"
        >
          Get 200-SKU Bulk Pass ($19)
        </button>
      </div>

      <!-- Core Recurring Anchor -->
      <div class="rounded-2xl border-2 border-teal-600 bg-white p-6 shadow-md relative flex flex-col justify-between">
        <span class="absolute -top-3 left-5 rounded-full bg-teal-700 px-3 py-0.5 text-[11px] font-bold text-white">
          Most Popular
        </span>
        <div>
          <h2 class="text-base font-bold text-slate-900">Watchlist Radar Pro</h2>
          <p class="mt-1 text-xs text-slate-500">24/7 automated Warning Letter &amp; Recall radar</p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-slate-950">$29</span>
            <span class="text-xs text-slate-500">/ month</span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-700">
            <li>✓ <strong>Unlimited 200-SKU Bulk CSV Audits</strong> &amp; exports</li>
            <li>✓ <strong>10 Automated Watchlist Trackers</strong> (OEMs, brands, active ingredients, 510(k) codes)</li>
            <li>✓ Monitors <strong>BOTH live FDA Warning Letters &amp; openFDA Recalls</strong> every 12h</li>
            <li>✓ Instant Email, Slack &amp; JSON Webhook alerts</li>
            <li>✓ Self-serve Alert Portal + 7-day free pilot</li>
          </ul>
        </div>
        <button
          type="button"
          data-plan="Watchlist Radar Pro ($29/mo)"
          class="plan-cta-btn mt-8 w-full rounded-xl bg-teal-700 px-4 py-3 text-xs font-bold text-white hover:bg-teal-800 cursor-pointer"
        >
          Start 7-Day Free Pilot ($29/mo)
        </button>
      </div>

      <!-- Agency / Multi-Brand -->
      <div class="rounded-2xl border border-slate-200 bg-slate-950 text-white p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold">Agency &amp; Aggregator</h2>
          <p class="mt-1 text-xs text-slate-400">For multi-brand operators &amp; RA consultants</p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold">$79</span>
            <span class="text-xs text-slate-400">/ month</span>
          </div>
          <ul class="mt-6 space-y-2.5 text-xs text-slate-200">
            <li>✓ <strong>Unlimited Watchlist Trackers</strong> across all FDA verticals</li>
            <li>✓ Unlimited 200-SKU CSV audits for client catalogs</li>
            <li>✓ CDRH 510(k) predicate &amp; product-code clearance alerts</li>
            <li>✓ Priority structured JSON Webhook feed (Zapier / Make / Teams)</li>
            <li>✓ Monthly executive compliance digest for QA trails</li>
          </ul>
        </div>
        <button
          type="button"
          data-plan="Agency & Aggregator ($79/mo)"
          class="plan-cta-btn mt-8 w-full rounded-xl bg-teal-500 px-4 py-3 text-xs font-bold text-slate-950 hover:bg-teal-400 cursor-pointer"
        >
          Start 7-Day Free Pilot ($79/mo)
        </button>
      </div>
    </div>

    <!-- Automated Fulfillment Transparency Box -->
    <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 grid gap-4 md:grid-cols-3 text-xs text-slate-700">
      <div>
        <h3 class="font-bold text-slate-950 mb-1">1. Instant Automated Delivery</h3>
        <p class="leading-relaxed">Upon checkout, our webhook issues your License Key immediately via email—zero manual onboarding calls or delays.</p>
      </div>
      <div>
        <h3 class="font-bold text-slate-950 mb-1">2. Self-Serve Alert Portal</h3>
        <p class="leading-relaxed">Log into <a href={withBase('/alerts/')} class="text-teal-700 font-semibold underline">/alerts/</a> with your key anytime to add contract manufacturers, ingredients, or Slack webhooks.</p>
      </div>
      <div>
        <h3 class="font-bold text-slate-950 mb-1">3. Clear Refunds &amp; Cancellation</h3>
        <p class="leading-relaxed">Cancel subscriptions anytime with 1 click. See our <a href={withBase('/refund/')} class="text-teal-700 font-semibold underline">Refund Policy</a> and <a href={withBase('/terms/')} class="text-teal-700 font-semibold underline">Terms of Service</a>.</p>
      </div>
    </div>
  </section>

  <WatchlistModal client:idle locale="en" />

  <script is:inline>
    document.querySelectorAll('.plan-cta-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var plan = btn.getAttribute('data-plan') || 'Watchlist Radar Pro ($29/mo)';
        window.dispatchEvent(new CustomEvent('regpulse:open-watchlist', { detail: { plan: plan } }));
      });
    });
  </script>
</BaseLayout>
