---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlertPortal from '../../components/AlertPortal';
---

<BaseLayout
  title="Self-Serve FDA Watchlist & License Key Portal | RegPulse"
  description="Manage your automated FDA Warning Letters and openFDA Recall alerts, update tracked OEM manufacturers or active ingredients, and configure Slack or JSON Webhooks."
  canonicalPath="/alerts/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
        Zero-Touch Automated Fulfillment
      </p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        Subscriber Watchlist &amp; Alert Portal
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">
        Sign in with the License Key delivered automatically to your inbox upon checkout. Add or edit OEMs, competitor brands, active ingredients, and Slack/Webhook endpoints anytime—every 12-hour FDA sync checks your watchlist automatically.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <AlertPortal client:load locale="en" />
  </section>
</BaseLayout>
