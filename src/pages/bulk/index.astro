---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BulkCatalogScanner from '../../components/BulkCatalogScanner';
import WatchlistModal from '../../components/WatchlistModal';
import recallsData from '../../data/recalls.json';
import warningLettersData from '../../data/warning_letters.json';
import { COMPLIANCE_RULES } from '../../data/complianceRules';
import type { RecallRecord, WarningLetterRecord } from '../../engine/scanner';

const recalls = recallsData as RecallRecord[];
const warningLetters = warningLettersData as WarningLetterRecord[];
---

<BaseLayout
  title="Bulk 200-SKU CSV FDA Compliance Pre-Flight Scanner | RegPulse"
  description="Upload your Amazon Flat File or Shopify product CSV to audit up to 200 SKUs in under 1 second against 40 federal FDA, MoCRA, DSHEA, CVM, and EPA FIFRA rules."
  canonicalPath="/bulk/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
        Catalog-Wide Compliance Pre-Flight • 100% Browser-Local
      </p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        Bulk CSV Catalog Scanner (Up to 200 SKUs)
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-3xl">
        Screen an entire Amazon Seller Central or Shopify catalog against all {COMPLIANCE_RULES.length} statutory FDA, OTC Monograph, MoCRA, Pet CVM, and EPA FIFRA rules in one click. Preview your first 3 SKUs free, then unlock all 200 rows plus a ready-to-assign Remediation CSV export with a $19 Bulk Pass or Watchlist Radar Pro License Key.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <BulkCatalogScanner client:load recalls={recalls} warningLetters={warningLetters} locale="en" />
  </section>

  <WatchlistModal client:idle locale="en" />
</BaseLayout>
