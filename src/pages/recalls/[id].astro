---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WatchlistModal from '../../components/WatchlistModal';
import recallsData from '../../data/recalls.json';
import type { RecallRecord } from '../../engine/scanner';

export function getStaticPaths() {
  const recalls = recallsData as RecallRecord[];
  return recalls.map((rec) => ({
    params: { id: rec.id },
    props: { rec },
  }));
}

interface Props {
  rec: RecallRecord;
}

const { rec } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const VERTICAL_ZH: Record<string, string> = {
  'Dietary Supplements': '膳食补充剂',
  'Cosmetics & Skincare': '美妆护肤',
  'Medical & Beauty Devices': '医疗/美容器械',
  'OTC & Unapproved Drugs': 'OTC/未获批药',
  'Food & Consumables': '食品与消费品',
};
const TAG_ZH: Record<string, string> = {
  'Unapproved New Drug': '未获批新药',
  'Tainted / Hidden Drug API': '非法添加西药',
  'Undeclared Allergen / Colorant': '未标明过敏原/色素',
  'Misbranding / Label Defect': '错误标签/包装缺陷',
  'CGMP / Contamination': 'CGMP/微生物污染',
  'Heavy Metals / Chemical': '重金属/化学超标',
  '510(k) / Clearance Issue': '510(k) 许可缺失',
  'Regulatory Enforcement': '常规监管执法',
};
---

<BaseLayout
  title={`${rec.recallingFirm} FDA Recall (${rec.recallNumber}) — ${rec.classification} | RegPulse`}
  description={`Official openFDA ${rec.classification} recall record for ${rec.recallingFirm} (${rec.recallNumber}): ${rec.reasonForRecall.slice(0, 145)}`}
  canonicalPath={`/recalls/${rec.id}/`}
>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-slate-500">
      <a href={withBase('/')} class="hover:text-slate-900">
        <span data-i18n-en>Home</span>
        <span data-i18n-zh class="hidden">首页</span>
      </a>
      <span class="mx-1.5">/</span>
      <a href={withBase('/recalls/')} class="hover:text-slate-900">
        <span data-i18n-en>FDA Recall Radar</span>
        <span data-i18n-zh class="hidden">FDA 召回雷达</span>
      </a>
      <span class="mx-1.5">/</span>
      <span class="font-mono text-slate-800">{rec.recallNumber}</span>
    </nav>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span
          class:list={[
            'inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold uppercase',
            rec.classification === 'Class I'
              ? 'bg-red-100 text-red-900'
              : rec.classification === 'Class II'
                ? 'bg-amber-100 text-amber-900'
                : 'bg-slate-100 text-slate-800',
          ]}
        >
          {rec.classification}
        </span>
        <span class="rounded-md bg-teal-50 border border-teal-200 px-2.5 py-1 text-xs font-semibold text-teal-900">
          <span data-i18n-en>{rec.vertical}</span>
          <span data-i18n-zh class="hidden">{VERTICAL_ZH[rec.vertical] || rec.vertical}</span>
        </span>
        <span class="font-mono text-xs text-slate-500">Recall #{rec.recallNumber}</span>
      </div>

      <h1 id="main-content" tabindex="-1" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-950">
        {rec.recallingFirm} — FDA {rec.classification} Enforcement Record
      </h1>

      <dl class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 border-y border-slate-100 py-4 text-xs">
        <div>
          <dt class="text-slate-500 font-semibold">
            <span data-i18n-en>Report Date</span>
            <span data-i18n-zh class="hidden">报告日期</span>
          </dt>
          <dd class="mt-1 font-mono font-bold text-slate-900">{rec.reportDate || 'N/A'}</dd>
        </div>
        <div>
          <dt class="text-slate-500 font-semibold">
            <span data-i18n-en>Initiation Date</span>
            <span data-i18n-zh class="hidden">召回启动日</span>
          </dt>
          <dd class="mt-1 font-mono font-bold text-slate-900">{rec.initiationDate || 'N/A'}</dd>
        </div>
        <div>
          <dt class="text-slate-500 font-semibold">
            <span data-i18n-en>Status</span>
            <span data-i18n-zh class="hidden">当前状态</span>
          </dt>
          <dd class="mt-1 font-bold text-slate-900">{rec.status || 'Active'}</dd>
        </div>
        <div>
          <dt class="text-slate-500 font-semibold">
            <span data-i18n-en>Firm Location</span>
            <span data-i18n-zh class="hidden">企业所在地</span>
          </dt>
          <dd class="mt-1 font-bold text-slate-900">
            {[rec.city, rec.state, rec.country].filter(Boolean).join(', ') || 'U.S.'}
          </dd>
        </div>
      </dl>

      <div class="mt-6 space-y-5">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">
            <span data-i18n-en>Reason for FDA Recall</span>
            <span data-i18n-zh class="hidden">FDA 官方召回原因（原文）</span>
          </h2>
          <p class="mt-2 rounded-xl bg-red-50/60 border border-red-200 p-4 text-sm font-medium text-red-950 leading-relaxed">
            {rec.reasonForRecall}
          </p>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">
            <span data-i18n-en>Affected Product Description</span>
            <span data-i18n-zh class="hidden">涉事产品明细描述（原文）</span>
          </h2>
          <p class="mt-2 text-sm text-slate-800 leading-relaxed">{rec.productDescription}</p>
        </div>

        {rec.distributionPattern && (
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">
              <span data-i18n-en>Distribution Pattern</span>
              <span data-i18n-zh class="hidden">分销渠道与波及范围</span>
            </h2>
            <p class="mt-1.5 text-sm text-slate-700">{rec.distributionPattern}</p>
          </div>
        )}

        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">
            <span data-i18n-en>Risk Classification Tags</span>
            <span data-i18n-zh class="hidden">风险分类标签</span>
          </h2>
          <div class="mt-2 flex flex-wrap gap-2">
            {rec.riskTags.map((tag) => (
              <span class="rounded-lg bg-slate-100 border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-800">
                <span data-i18n-en>{tag}</span>
                <span data-i18n-zh class="hidden">{TAG_ZH[tag] || tag}</span>
              </span>
            ))}
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
          <a
            href={rec.officialSourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-blue-700 hover:underline"
          >
            <span data-i18n-en>Verify Raw Official openFDA Record (JSON) ↗</span>
            <span data-i18n-zh class="hidden">直连验证 openFDA 官方原始记录 (JSON) ↗</span>
          </a>
          <div class="flex flex-wrap gap-2.5">
            <a
              href={withBase('/')}
              class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-800 hover:bg-slate-50"
            >
              <span data-i18n-en>Scan Your Own Listing Free</span>
              <span data-i18n-zh class="hidden">免费扫描我的 Listing</span>
            </a>
            <button
              type="button"
              id="monitor-this-firm-btn"
              data-firm={rec.recallingFirm}
              class="rounded-xl bg-teal-700 px-4 py-2 text-xs font-bold text-white hover:bg-teal-800 cursor-pointer"
            >
              <span data-i18n-en>Monitor “{rec.recallingFirm.slice(0, 24)}” Alerts</span>
              <span data-i18n-zh class="hidden">监控该涉事企业后续动态</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </article>

  <WatchlistModal client:idle />

  <script is:inline>
    document.getElementById('monitor-this-firm-btn')?.addEventListener('click', function (e) {
      var firm = e.currentTarget.getAttribute('data-firm') || '';
      var isZh = document.documentElement.lang === 'zh-CN';
      window.dispatchEvent(
        new CustomEvent('regpulse:open-watchlist', {
          detail: { plan: isZh ? '中文跨境监控季卡 (¥199/季)' : 'Starter Watchlist ($29/mo)', prefillKeywords: firm },
        })
      );
    });
  </script>
</BaseLayout>
