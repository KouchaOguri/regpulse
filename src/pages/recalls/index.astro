---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecallsExplorer from '../../components/RecallsExplorer';
import WatchlistModal from '../../components/WatchlistModal';
import recallsData from '../../data/recalls.json';
import clearancesData from '../../data/clearances_510k.json';
import cosmeticTrends from '../../data/cosmetic_trends.json';
import rssAlerts from '../../data/rss_alerts.json';
import metadata from '../../data/metadata.json';
import type { RecallRecord } from '../../engine/scanner';

const recalls = recallsData as RecallRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const syncLabel = (metadata as any).lastSyncedDisplay || metadata.lastSyncedUtc;
const nonTalcCount = (cosmeticTrends as any).nonTalcEventsCount || 0;
---

<BaseLayout
  title="Live FDA Recall & Enforcement Radar — Cosmetics, Supplements & Devices | RegPulse"
  description="Search live openFDA enforcement recalls prioritized for supplements, cosmetics, and devices, plus non-talc cosmetic adverse event signals and recent 510(k) clearances."
  canonicalPath="/recalls/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
            <span data-i18n-en>Live openFDA Regulatory Feed</span>
            <span data-i18n-zh class="hidden">美国 openFDA 官方实时监管直连</span>
          </p>
          <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
            <span data-i18n-en>FDA Enforcement, Recall &amp; 510(k) Radar</span>
            <span data-i18n-zh class="hidden">美国 FDA 实时召回、执法与 510(k) 监控雷达</span>
          </h1>
          <p class="mt-3 text-sm sm:text-base text-slate-600">
            <span data-i18n-en>
              Synced every 12 hours from openFDA APIs (prioritizing Supplements, Cosmetics, OTC Drugs &amp; Devices) and FDA.gov RSS. Last sync: <strong class="font-mono text-slate-800 whitespace-nowrap">{syncLabel}</strong>.
            </span>
            <span data-i18n-zh class="hidden">
              每 12 小时自动拉取 openFDA 官方 API（定向覆盖膳食补充剂、美妆护肤、OTC 未获批药与器械）及 FDA.gov 官方 RSS。最近同步：<strong class="font-mono text-slate-800 whitespace-nowrap">{syncLabel}</strong>。
            </span>
          </p>
        </div>
        <button
          type="button"
          id="open-radar-alert-btn"
          class="rounded-xl bg-teal-700 px-4 py-2.5 text-xs font-bold text-white hover:bg-teal-800 cursor-pointer"
        >
          <span data-i18n-en>Set Supplier / Ingredient Alert ($29/mo)</span>
          <span data-i18n-zh class="hidden">订阅供应商/成分实时预警 (¥199/季)</span>
        </button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    <RecallsExplorer client:load recalls={recalls} basePath={base} />

    <!-- Secondary Live Feeds: Non-Talc Cosmetic Adverse Events & 510(k) Clearances -->
    <div class="grid gap-8 lg:grid-cols-2">
      <!-- Non-Talc Skincare Adverse Events -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-extrabold text-slate-950">
          <span data-i18n-en>openFDA Cosmetic Adverse Events — Non-Talc Skincare &amp; Beauty Reactions</span>
          <span data-i18n-zh class="hidden">openFDA 化妆品不良事件 — 去滑石粉诉讼后的真实护肤高频反应</span>
        </h2>
        <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
          <span data-i18n-en>
            Showing live top reactions across <strong>{nonTalcCount.toLocaleString()} non-talc/non-powder events</strong> (filtered from {cosmeticTrends.totalEventsInOpenFDA.toLocaleString()} raw openFDA CAERS filings, which are heavily skewed by legacy talc litigation).
          </span>
          <span data-i18n-zh class="hidden">
            openFDA 原始 {cosmeticTrends.totalEventsInOpenFDA.toLocaleString()} 条数据包含大量历史婴儿爽身粉滑石粉集体诉讼；此处实时过滤粉类/滑石粉条目，呈现 <strong>{nonTalcCount.toLocaleString()} 条</strong>真实护肤/美妆不良反应分布：
          </span>
        </p>
        <ul class="mt-4 space-y-2">
          {cosmeticTrends.topReactions.slice(0, 10).map((item: { term: string; count: number }) => (
            <li class="flex items-center justify-between gap-3 rounded-lg bg-slate-50 border border-slate-100 px-3 py-2 text-xs">
              <span class="font-semibold text-slate-800">{item.term}</span>
              <span class="font-mono font-bold text-teal-800 tabular-nums">{item.count.toLocaleString()}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Recent 510(k) Clearances -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-extrabold text-slate-950">
          <span data-i18n-en>Latest FDA 510(k) Device Clearances</span>
          <span data-i18n-zh class="hidden">最新 FDA 510(k) 医疗/美容器械获批清单</span>
        </h2>
        <p class="mt-1.5 text-xs text-slate-600">
          <span data-i18n-en>Track newly cleared predicate devices and CDRH product codes directly from FDA.gov.</span>
          <span data-i18n-zh class="hidden">实时追踪 FDA 器械中心（CDRH）最新获批的 510(k) 实质等同器械与产品代码。</span>
        </p>
        <ul class="mt-4 space-y-2.5">
          {clearancesData.slice(0, 8).map((c: any) => (
            <li class="rounded-lg border border-slate-200 bg-slate-50/70 p-3 text-xs">
              <div class="flex items-center justify-between gap-2">
                <a
                  href={c.fdaUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono font-bold text-blue-700 hover:underline"
                >
                  {c.kNumber}{c.productCode ? ` (${c.productCode})` : ''}
                </a>
                <span class="font-mono text-slate-500">{c.decisionDate}</span>
              </div>
              <div class="mt-1 font-semibold text-slate-900">{c.deviceName}</div>
              <div class="mt-0.5 text-slate-600">{c.applicant}{c.countryCode ? ` • ${c.countryCode}` : ''}</div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Official FDA.gov Recalls RSS Stream -->
    {rssAlerts.length > 0 && (
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-extrabold text-slate-950 mb-4">
          <span data-i18n-en>Latest Official FDA.gov Recall Announcements (RSS)</span>
          <span data-i18n-zh class="hidden">FDA.gov 官方最新召回公告直连流（已清洗 HTML 实体）</span>
        </h2>
        <ul class="grid gap-3 md:grid-cols-2">
          {rssAlerts.slice(0, 10).map((item: any) => (
            <li class="rounded-xl border border-slate-200 p-3.5 hover:border-teal-400 transition-colors">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-slate-900 hover:text-teal-800 underline-offset-2 hover:underline"
              >
                {item.title}
              </a>
              <p class="mt-1 text-[11px] text-slate-600 line-clamp-2">{item.summary}</p>
              <span class="mt-1.5 block font-mono text-[10px] text-slate-400">{item.pubDate}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <WatchlistModal client:idle />

  <script is:inline>
    document.getElementById('open-radar-alert-btn')?.addEventListener('click', function () {
      var isZh = document.documentElement.lang === 'zh-CN';
      window.dispatchEvent(new CustomEvent('regpulse:open-watchlist', { detail: { plan: isZh ? '中文跨境监控季卡 (¥199/季)' : 'Starter Watchlist ($29/mo)' } }));
    });
  </script>
</BaseLayout>
