---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MocraChecklist from '../../components/MocraChecklist';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<BaseLayout
  title="2026 MoCRA Cosmetics Compliance & Amazon Ungating Checklist | RegPulse"
  description="Interactive 2026 MoCRA compliance checklist for Amazon and Shopify cosmetic brands: Facility FEI, Product Listing, U.S. Adverse Event label contact, and solving the Amazon FDA Certificate paradox."
  canonicalPath="/mocra/"
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-700">
        Modernization of Cosmetics Regulation Act (MoCRA)
      </p>
      <h1 id="main-content" tabindex="-1" class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950">
        2026 MoCRA Cosmetics &amp; Amazon Compliance Checklist
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Under MoCRA, responsibility is split between your contract manufacturer (Facility Registration) and you as the Brand Owner / Responsible Person (Product Listing, Safety Substantiation, U.S. Adverse-Event Contact). Audit your readiness below (auto-saved locally) and print your dossier checklist.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <MocraChecklist client:load locale="en" />

    <div class="rounded-2xl border border-slate-200 bg-slate-900 text-white p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print">
      <div>
        <h2 class="text-base font-bold">Next Step: Scan Your Cosmetic Copy for Hidden Drug Claims</h2>
        <p class="mt-1 text-xs text-slate-300">
          Catch acne, eczema, SPF sunscreen, lidocaine numbing, anti-dandruff, exosome/stem-cell, hydroquinone, and EPA antibacterial traps before Amazon bots do.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 shrink-0">
        <a
          href={withBase('/')}
          class="rounded-xl bg-teal-500 px-4 py-2.5 text-xs font-bold text-slate-950 hover:bg-teal-400"
        >
          Single Scanner →
        </a>
        <a
          href={withBase('/bulk/')}
          class="rounded-xl border border-slate-600 bg-slate-800 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-700"
        >
          200-SKU Bulk CSV
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
