---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonicalPath = '/', jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => {
  if (path === '/') return `${base}/`;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
};
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string) => {
  const target = withBase(path).replace(/\/$/, '') || '/';
  return currentPath === target;
};
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://regpulsehq.com';
const canonicalUrl = `${siteOrigin}${withBase(canonicalPath)}`;
const ogImageUrl = `${siteOrigin}${withBase('/og-card.png')}`;

const navItems = [
  { href: '/', label: 'Scanner' },
  { href: '/bulk/', label: 'Bulk CSV' },
  { href: '/warning-letters/', label: 'Warning Letters' },
  { href: '/recalls/', label: 'Recalls' },
  { href: '/rules/', label: '40 Rules' },
  { href: '/mocra/', label: 'MoCRA' },
  { href: '/pricing/', label: 'Pricing' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate icon" href={withBase('/favicon.ico')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- Cookie-free Cloudflare Web Analytics (L2 Real External Telemetry) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "66f61383b9d9419dab4c168311040e94"}'></script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased overflow-x-clip">
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-sm no-print">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between gap-3">
          <a href={withBase('/')} class="flex items-center gap-2.5 text-slate-900 font-bold tracking-tight shrink-0">
            <img src={withBase('/favicon.svg')} alt="" width="30" height="30" class="rounded-lg" />
            <span class="text-lg">RegPulse</span>
            <span class="hidden lg:inline-flex items-center rounded-md bg-teal-50 px-2 py-0.5 text-[11px] font-semibold text-teal-800 border border-teal-200">
              FDA &amp; MoCRA Intel
            </span>
          </a>

          <nav aria-label="Primary" class="hidden md:flex items-center gap-0.5">
            <ul class="flex items-center gap-0.5">
              {navItems.map((item) => {
                const active = isCurrent(item.href);
                return (
                  <li>
                    <a
                      href={withBase(item.href)}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'inline-flex items-center px-2.5 py-2 text-xs lg:text-sm font-medium rounded-lg transition-colors border-b-2 whitespace-nowrap',
                        active
                          ? 'text-teal-900 bg-teal-50/80 border-teal-700 font-semibold'
                          : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100 border-transparent',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>

          <div class="flex items-center gap-2 shrink-0">
            <a
              href={withBase('/alerts/')}
              class="hidden lg:inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 min-h-[36px]"
            >
              Portal
            </a>

            <a
              href={withBase('/pricing/')}
              class="hidden sm:inline-flex items-center rounded-lg bg-teal-700 px-3.5 py-2 text-xs font-semibold text-white hover:bg-teal-800 transition-colors min-h-[36px] whitespace-nowrap"
            >
              Start Monitoring
            </a>

            <button
              id="mobile-menu-btn"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-nav-panel"
              class="md:hidden inline-flex items-center justify-center rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100 min-h-[40px] min-w-[44px]"
            >
              Menu
            </button>
          </div>
        </div>

        <nav id="mobile-nav-panel" aria-label="Mobile" hidden class="md:hidden pb-4 pt-2 border-t border-slate-100">
          <ul class="flex flex-col gap-1">
            {navItems.map((item) => {
              const active = isCurrent(item.href);
              return (
                <li>
                  <a
                    href={withBase(item.href)}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'block rounded-lg px-3 py-2.5 text-sm font-medium',
                      active
                        ? 'bg-teal-50 text-teal-900 font-semibold border-l-4 border-teal-700'
                        : 'text-slate-700 hover:bg-slate-100',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
            <li>
              <a
                href={withBase('/alerts/')}
                class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-100"
              >
                Subscriber Alert Portal
              </a>
            </li>
            <li class="pt-2">
              <a
                href={withBase('/pricing/')}
                class="block text-center rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-teal-800"
              >
                Bulk Pass ($19) or Radar Pro ($29/mo)
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-slate-900 text-slate-300 mt-16 no-print">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid gap-8 md:grid-cols-4">
          <div>
            <div class="flex items-center gap-2 text-white font-bold text-base mb-3">
              <img src={withBase('/favicon.svg')} alt="" width="24" height="24" class="rounded" />
              <span>RegPulse</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-400">
              Automated FDA drug-claim screening, 200-SKU CSV pre-flight audits, MoCRA compliance checks, and live FDA Warning Letters &amp; openFDA recall monitoring built for U.S. e-commerce brands.
            </p>
          </div>

          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">
              Product &amp; Feeds
            </h2>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href={withBase('/')} class="hover:text-white">Free Listing Claim Scanner</a></li>
              <li><a href={withBase('/bulk/')} class="hover:text-white">Bulk CSV Catalog Pre-Flight (200 SKUs)</a></li>
              <li><a href={withBase('/warning-letters/')} class="hover:text-white">Live FDA Warning Letters Radar</a></li>
              <li><a href={withBase('/recalls/')} class="hover:text-white">Live openFDA Recalls &amp; 510(k)</a></li>
              <li><a href={withBase('/rules/')} class="hover:text-white">40 Statutory 21 CFR &amp; FIFRA Rules</a></li>
              <li><a href={withBase('/mocra/')} class="hover:text-white">2026 MoCRA Cosmetics Checklist</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">
              Account &amp; Policies
            </h2>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href={withBase('/pricing/')} class="hover:text-white">Self-Serve Pricing</a></li>
              <li><a href={withBase('/alerts/')} class="hover:text-white">Subscriber Watchlist &amp; License Portal</a></li>
              <li><a href={withBase('/terms/')} class="hover:text-white">Terms of Service</a></li>
              <li><a href={withBase('/privacy/')} class="hover:text-white">Privacy Policy</a></li>
              <li><a href={withBase('/refund/')} class="hover:text-white">Refund &amp; Cancellation Policy</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">
              Regulatory Notice &amp; Attribution
            </h2>
            <p class="text-xs leading-relaxed text-slate-400">
              RegPulse is an independent software tool and is <strong>not affiliated with, endorsed by, or sponsored by the U.S. Food and Drug Administration (FDA)</strong>.
              Outputs are informational screening aids citing public federal statutes (eCFR), official FDA.gov Warning Letters, and <a href="https://open.fda.gov/license" target="_blank" rel="noopener noreferrer" class="underline text-teal-400 hover:text-teal-300">openFDA public datasets</a>, and do not constitute legal advice.
            </p>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs text-slate-500">
          <span>© 2026 RegPulse Regulatory Intelligence. Verified public data via FDA.gov, openFDA API &amp; eCFR.</span>
          <a href="mailto:support@regpulsehq.com?subject=%5BRegPulse%20Support%5D" class="hover:text-slate-300 underline underline-offset-2">
            Compliance Support Desk (support@regpulsehq.com)
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var menuBtn = document.getElementById('mobile-menu-btn');
        var mobileNav = document.getElementById('mobile-nav-panel');
        if (menuBtn && mobileNav) {
          menuBtn.addEventListener('click', function () {
            var expanded = menuBtn.getAttribute('aria-expanded') === 'true';
            menuBtn.setAttribute('aria-expanded', String(!expanded));
            mobileNav.hidden = expanded;
          });
        }
      })();
    </script>
  </body>
</html>
